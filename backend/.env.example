# Database
DATABASE_URL="postgresql://user:password@localhost:5432/vouchd_db?schema=public"

# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Solana
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_NETWORK="devnet"
ESCROW_PROGRAM_ID="YourEscrowProgramPublicKeyHere"

# FairScale API
FAIRSCALE_API_KEY="your-fairscale-api-key-from-form"
FAIRSCALE_API_URL="https://api.fairscale.com/v1"

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8081"

# Socket.io
SOCKET_PORT=4001
